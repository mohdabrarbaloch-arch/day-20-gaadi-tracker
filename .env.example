# ── Gaadi — environment configuration ──────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Flask-style secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL.
# SQLite (default, zero setup — file created automatically):
DATABASE_URL=sqlite:///./gaadi.db
# PostgreSQL via docker-compose:
# DATABASE_URL=postgresql+psycopg2://gaadi:gaadi@db:5432/gaadi

# CORS: comma-separated list of allowed origins (frontend domains)
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Comma-separated engine intervals for the maintenance scheduler.
# Format: <key>=<name>:<km_interval>:<days_interval>
# Example below: oil every 5000 km OR 90 days, tires every 10000 km OR 180 days.
MAINTENANCE_INTERVALS=oil=Oil Change:5000:90,tires=Tire Rotation:10000:180,brakes=Brake Inspection:20000:365,general=General Service:10000:180
